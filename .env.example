# ============================================================
# badhope / badhope profile automation configuration
# ============================================================
# Copy this file to `.env` for local development. None of the
# variables below are committed to git (see `.gitignore`).
# In production all values are injected by GitHub Actions.
# ============================================================

# ------------------------------------------------------------
# GitHub
# ------------------------------------------------------------
# Optional: provide a personal access token to lift the rate
# limit from 60 to 5000 requests/hour. In GitHub Actions the
# `GITHUB_TOKEN` secret is injected automatically.
GITHUB_TOKEN=

# Override the API root for GitHub Enterprise installations.
GITHUB_API_URL=https://api.github.com

# Username whose repositories we are aggregating.
GITHUB_USERNAME=badhope

# Per-request timeout in seconds.
REQUEST_TIMEOUT=30

# Retry / backoff settings.
MAX_RETRIES=3
RETRY_DELAY=2.0

# How many repositories to request per pagination page.
GITHUB_PER_PAGE=100

# ------------------------------------------------------------
# Projects section
# ------------------------------------------------------------
PROJECTS_LIMIT=4
MORE_PROJECTS_LIMIT=5
# Comma-separated list of repository names to skip entirely.
EXCLUDED_REPOS=
# Optional: only show repositories carrying this topic.
REQUIRED_TOPIC=

# ------------------------------------------------------------
# Blog
# ------------------------------------------------------------
BLOG_ENABLED=true
CSDN_USER_ID=weixin_56622231
CSDN_RSS_URL=https://blog.csdn.net/weixin_56622231/rss/list
MAX_POSTS=3

# ------------------------------------------------------------
# Daily quote
# ------------------------------------------------------------
# Comma-separated list of APIs to try (in order).
QUOTE_APIS=https://zenquotes.io/api/random,https://api.quotable.io/random
QUOTE_TIMEOUT=10
QUOTE_MAX_RETRIES=3

# ------------------------------------------------------------
# Snake animation
# ------------------------------------------------------------
SNAKE_BRANCH=output
SNAKE_DARK_PALETTE=github-dark
SNAKE_FILE_NAME=github-contribution-grid-snake-dark.svg

# ------------------------------------------------------------
# SVG generation
# ------------------------------------------------------------
SVG_OUTPUT_DIR=assets/effects
BADGE_COLOR=58a6ff
SECONDARY_COLOR=93c5fd
LANGUAGE_COLOR=3776AB

# ------------------------------------------------------------
# Documentation / GitHub Pages
# ------------------------------------------------------------
DOCS_DIR=docs
SITE_URL=https://badhope.github.io
JEKYLL_ENV=production
DOCS_DEPLOY_ON_PUSH=true

# ------------------------------------------------------------
# README / logging
# ------------------------------------------------------------
README_PATH=README.md
LOG_LEVEL=INFO

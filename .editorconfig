# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 用行尾双空格表示换行，去掉会破坏排版
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.mjs]
indent_size = 2

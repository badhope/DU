{
  "name": "du",
  "version": "0.5.3",
  "private": true,
  "description": "Tianji — a local-only Chinese metaphysics master arena. Every reading, chart and vote stays in the browser.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://gitcode.com/badhope/DU",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/badhope/DU.git"
  },
  "bugs": "https://gitcode.com/badhope/DU/issues",
  "keywords": [
    "bazi",
    "ziwei",
    "meihua",
    "chinese-metaphysics",
    "divination",
    "local-first",
    "offline",
    "vue3",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.vitest-results.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --grep @screenshots",
    "verify:quotes": "node scripts/verify-quotes.mjs",
    "gen:readme": "node scripts/gen-readme.mjs",
    "check:readme": "node scripts/gen-readme.mjs --check",
    "check:local-only": "node scripts/check-local-only.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "corpus": "node scripts/sync-corpus.mjs ../du-corpus",
    "check": "npm run typecheck && npm run check:boundaries && npm run test && npm run verify:quotes && npm run check:corpus && npm run check:content && npm run check:versions && npm run check:readme && npm run build && npm run check:local-only",
    "check:corpus": "node scripts/check-corpus.mjs",
    "build:all": "node scripts/build-all.mjs",
    "cli": "node scripts/build-all.mjs && node build/cli.mjs",
    "mcp": "node scripts/build-all.mjs && node build/mcp.mjs",
    "serve": "node scripts/build-all.mjs && node build/cli.mjs serve",
    "test:runtime": "vitest run tests/runtime.spec.ts",
    "test:e2e:backend": "node scripts/build-all.mjs && playwright test --config playwright.backend.config.ts",
    "check:e2e": "playwright test && npm run test:e2e:backend",
    "check:content": "node scripts/check-content-safety.mjs",
    "test:mutation": "node scripts/mutation-test.mjs",
    "test:mutation:quick": "node scripts/mutation-test.mjs --quick"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "iztro": "^2.6.4",
    "lunar-typescript": "^1.8.6",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "opencc-js": "^1.4.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  },
  "bin": {
    "tianji": "./build/cli.mjs"
  },
  "files": [
    "build",
    "dist",
    "src",
    "scripts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}

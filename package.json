{
  "name": "du",
  "private": true,
  "version": "0.1.0",
  "description": "天机台：不上传数据的本地玄学大师测评平台。",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:quotes": "node scripts/verify-quotes.mjs",
    "gen:readme": "node scripts/gen-readme.mjs",
    "check:readme": "node scripts/gen-readme.mjs --check",
    "check:local-only": "node scripts/check-local-only.mjs",
    "corpus": "node scripts/sync-corpus.mjs ../du-corpus",
    "check": "npm run typecheck && npm run test && npm run verify:quotes && npm run check:readme && npm run build && npm run check:local-only"
  },
  "dependencies": {
    "lunar-typescript": "^1.8.6",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^18.0.1",
    "opencc-js": "^1.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}

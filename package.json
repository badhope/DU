{
  "name": "du",
  "version": "0.3.1",
  "private": true,
  "description": "Tianji — a local-only Chinese metaphysics master arena. Every reading, chart and vote stays in the browser.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://gitcode.com/badhope/DU",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/badhope/DU.git"
  },
  "bugs": "https://gitcode.com/badhope/DU/issues",
  "keywords": [
    "bazi",
    "ziwei",
    "meihua",
    "chinese-metaphysics",
    "divination",
    "local-first",
    "offline",
    "vue3",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --grep @screenshots",
    "verify:quotes": "node scripts/verify-quotes.mjs",
    "gen:readme": "node scripts/gen-readme.mjs",
    "check:readme": "node scripts/gen-readme.mjs --check",
    "check:local-only": "node scripts/check-local-only.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "corpus": "node scripts/sync-corpus.mjs ../du-corpus",
    "check": "npm run typecheck && npm run check:boundaries && npm run test && npm run verify:quotes && npm run check:corpus && npm run check:versions && npm run check:readme && npm run build && npm run check:local-only",
    "check:corpus": "node scripts/check-corpus.mjs"
  },
  "dependencies": {
    "lunar-typescript": "^1.8.6",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "opencc-js": "^1.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
